{
  "name": "making-your-ai-unlimited",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:all": "npm run build && npm run extension:build",
    "dev": "tsx watch src/server.ts",
    "fake-ui": "tsx src/fake-ui.ts",
    "extension:build": "tsc -p extensions/vscode/tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "node --import tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/sensible": "^6.0.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "playwright": "^1.64.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/vscode": "^1.140.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
